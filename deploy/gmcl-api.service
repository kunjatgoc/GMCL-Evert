# Global Market League -- the uvicorn process, under systemd.
#
# The README said to run it under systemd and then left you to write this.
# Here it is. Without it the API does not come back after a reboot, and a
# crash at 3am stays down until somebody notices.
#
#     sudo cp deploy/gmcl-api.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now gmcl-api
#     systemctl status gmcl-api
#
# Logs go to the journal, so there is no file to rotate:
#
#     journalctl -u gmcl-api -f

[Unit]
Description=Global Market League API (uvicorn behind nginx)
Documentation=https://github.com/kunjatgoc/GMCL-Evert
# network-online rather than network: the pool opens connections to a remote
# Postgres on startup, and "an interface exists" is not "routing works".
After=network-online.target
Wants=network-online.target

[Service]
Type=exec

WorkingDirectory=/opt/GMCL-Evert

# EnvironmentFile and not uvicorn's --env-file. The two parse KEY=VALUE
# slightly differently around quoting, and this is the one that has been
# reading the live .env since September without complaint. Switching parsers
# during a migration is how a working secret becomes a wrong one.
EnvironmentFile=/opt/GMCL-Evert/.env

# 8011. This box runs six other apps and 8000 is StockBotAPI's -- binding it
# here would fail at best and steal traffic at worst. Bound to loopback, so
# the only way in is through nginx.
ExecStart=/opt/GMCL-Evert/.venv/bin/uvicorn api.index:app \
    --host 127.0.0.1 \
    --port 8011 \
    --workers 4

Restart=always
RestartSec=2

# A worker that cannot reach Postgres exits at once, and restarting four of
# them in a tight loop is how a database outage becomes a second outage.
StartLimitIntervalSec=60
StartLimitBurst=5

# Runs as root, which is what it already did before this file existed. Worth
# fixing, and deliberately not fixed in the same change that moves the app to
# a new path: a migration that also changes the owner of every file has two
# ways to fail and no way to tell them apart. Afterwards:
#
#     sudo useradd --system --home /opt/GMCL-Evert --shell /usr/sbin/nologin gmcl
#     sudo chown -R gmcl:gmcl /opt/GMCL-Evert
#     sudo chmod 600 /opt/GMCL-Evert/.env
#
# then add User=gmcl and Group=gmcl here. Nothing this process does needs
# privilege -- it binds 8011, not 80.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
