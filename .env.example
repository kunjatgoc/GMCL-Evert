# Copy to .env and fill in. .env is gitignored; never commit real values.

# Postgres connection string used by api/index.py.
# If the password gains a reserved character, percent-encode it here
# (! -> %21, & -> %26, @ -> %40) or libpq will misread the URL.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated origins allowed to POST /api/*. Only consulted when the page
# is served from a different origin than the API; in dev Vite proxies /api, so
# the default covers local work.
ALLOWED_ORIGINS=http://localhost:5173

# Where the site is served from. This builds the absolute password-reset link
# that goes out by email, so it is worth setting rather than inheriting: unset,
# it falls back to the first ALLOWED_ORIGINS entry, and if that list is empty
# too the fallback is localhost -- which mails every user a reset link into
# their own machine. Set it wherever the page is actually served from.
APP_ORIGIN=https://your-domain.example

# Optional. Point the frontend at an API on another origin. Unset means the
# same-origin /api/register and /api/real-account, which is what production uses.
# VITE_REGISTER_URL=
# VITE_REAL_ACCOUNT_URL=

# HMAC key for the admin session cookie (api/index.py). Any long random
# string; rotating it signs every admin out.
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Set to 0 for local http development so the session cookie is not marked
# Secure. Leave unset (or 1) in production.
# COOKIE_SECURE=0

# The mail configuration. Every one of these is read from the environment;
# api/index.py holds no mail value of its own, so a name left blank here is a
# setting the app genuinely does not have rather than one silently supplied
# from the source.
#
# Set the same names in the Vercel project environment for production.

# Mail goes through Resend, over plain SMTP. Nothing in the app is
# Resend-specific: any provider that speaks SMTP drops in by changing these
# five values, which is the reason it is SMTP and not their HTTP API.
#
#     https://resend.com/docs/send-with-smtp

# Where mail is handed to.
SMTP_HOST=smtp.resend.com

# Submission port, and what it means to Resend:
#   25, 587, 2587   STARTTLS -- plaintext, then upgraded. 587 is the default.
#   465, 2465       implicit TLS from the first byte.
# A server offering no encryption at all never receives the password.
SMTP_PORT=587

# Seconds to wait on the mail server before giving up. Blank means 10.
# SMTP_TIMEOUT=10

# The From header on every message that goes out. The domain must be verified
# in Resend or it refuses the send.
#
# Quoted because the value contains angle brackets, and an unquoted `<` is a
# redirect to any shell that sources this file. python-dotenv strips the
# quotes, so uvicorn --env-file sees the address either way -- but `set -a;
# . ./.env` does not, and reads the value as empty.
SMTP_FROM_EMAIL="Global Market League <support@playgml.com>"

# Amazon SES only: it groups a message under a configuration set when this
# header is present. Resend has no such concept, so it stays blank and
# api/index.py leaves the header off entirely.
EMAIL_CONFIGURATION_SET=

# The credentials, and the only secret part of the mail config. Resend wants
# the literal username `resend` and an API key as the password, issued at
# https://resend.com/api-keys -- not your account password.
#
# Blank is a supported state, not a broken one. Without them nothing can be
# mailed, and anything that has to mail answers 503 rather than pretending a
# code went out -- unless OTP_ECHO below is on, which gives codes somewhere
# else to go.
SMTP_USER=resend
SMTP_PASSWORD=

# Prints every confirmation code and reset link to the terminal the API runs
# in. Development only.
#
# A code in a log is a credential anyone with log access can sign in with, so
# this must never be set in the Vercel project environment. It is off unless
# it is exactly "1", so it has to be switched on deliberately.
#
# It also stands in for the mail server, which is how the sign-up and reset
# flows are walked through with no working mail account. That covers both
# shapes of "no mail": credentials left blank above, and credentials the
# provider has stopped accepting -- with this on, a refused send is reported
# on the terminal and the printed code still counts as delivered.
# OTP_ECHO=1
