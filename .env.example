# Copy to .env and fill in. .env is gitignored; never commit real values.

# Postgres connection string used by api/index.py.
# If the password gains a reserved character, percent-encode it here
# (! -> %21, & -> %26, @ -> %40) or libpq will misread the URL.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated origins allowed to POST /api/*. Only consulted when the page
# is served from a different origin than the API; in dev Vite proxies /api, so
# the default covers local work.
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Point the frontend at an API on another origin. Unset means the
# same-origin /api/register and /api/real-account, which is what production uses.
# VITE_REGISTER_URL=
# VITE_REAL_ACCOUNT_URL=

# HMAC key for the admin session cookie (api/index.py). Any long random
# string; rotating it signs every admin out.
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Set to 0 for local http development so the session cookie is not marked
# Secure. Leave unset (or 1) in production.
# COOKIE_SECURE=0

# Amazon SES SMTP, used to mail the sign-in code. Placeholders only in this
# file -- the real values live in .env, which is gitignored, and in the Vercel
# project environment. With SMTP_HOST unset, sign-in answers 503 rather than
# pretending a code went out.
#
# SES gives you an SMTP user and password from the console; they are not your
# AWS access key. Port 587 uses STARTTLS, 465 is implicit TLS, and the from
# address has to be verified in the same SES region as the host.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com

# Prints every confirmation code to the terminal. Development only.
#
# A code in a log is a credential anyone with log access can sign in with, so
# this must never be set in the Vercel project environment. It is off unless
# it is exactly "1", so it has to be switched on deliberately.
#
# With SMTP_HOST empty it also stands in for the mail server, which is how the
# sign-up flow can be walked through before SES credentials exist.
# OTP_ECHO=1
